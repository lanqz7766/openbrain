# Where the OpenBrain v1.0 release tree is mirrored locally.
# Should contain: cases/, metadata/, sample/, croissant.json, VERSION.
OPENBRAIN_RELEASE_ROOT=/path/to/openbrain_v1_0

# Where downstream evaluation cohorts live (IXI, Mindboggle-101, BrainLat).
# Each cohort sits in its own subdirectory; this is *not* part of the
# OpenBrain release.
OPENBRAIN_DATA_ROOT=/path/to/eval_cohorts

# Scratch space for analysis outputs (CSV manifests, retention pivots,
# per-arm prediction trees, etc.). Several scripts default to writing here.
OPENBRAIN_ANALYSIS_ROOT=/path/to/scratch_analysis

# Optional: where the M1/M2/M3 nnUNet checkpoints live, organised as
#   $OPENBRAIN_CKPT_ROOT/Dataset012_modernsurfer/nnUNetTrainer__nnUNetPlans__3d_fullres/
# See inference/README.md for how to obtain checkpoints.
OPENBRAIN_CKPT_ROOT=/path/to/nnUNet_results
